{
  "name": "satteri-comark",
  "version": "0.2.0",
  "author": "daylily <i@dayli.ly>",
  "license": "BSD-3-Clause",
  "description": "Support for Comark syntax in Sätteri",
  "homepage": "https://github.com/coclique/satteri-plugins",
  "bugs": "https://github.com/coclique/satteri-plugins/issues",
  "repository": "git+https://github.com/coclique/satteri-plugins.git",
  "keywords": [
    "satteri",
    "satteri-plugin",
    "markdown",
    "mdast",
    "directive",
    "mdx",
    "comark"
  ],
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./2colons": {
      "types": "./dist/2colons.d.ts",
      "import": "./dist/2colons.js"
    }
  },
  "scripts": {
    "build": "tsdown",
    "check": "tsc --noEmit",
    "test": "vitest",
    "coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@types/mdast": "catalog:",
    "confbox": "catalog:",
    "html-tags": "catalog:",
    "tiny-case": "catalog:",
    "unist-builder": "catalog:",
    "url-extras": "catalog:"
  },
  "devDependencies": {
    "satteri": "catalog:",
    "test-utils": "catalog:"
  },
  "peerDependencies": {
    "satteri": "catalog:"
  }
}
